{
  "version": 1,
  // Cycle optimization: Enable local replica optimizations
  "replica": {
    "artificial_delay": 300,
    "log_level": "info"
  },
  "canisters": {
    "cell_manager": {
      "type": "rust",
      "package": "cell_manager",
      "candid": "canisters/cell_manager/cell_manager.did"
    },
    "data_cell": {
      "type": "rust",
      "package": "data_cell",
      "candid": "canisters/data_cell/data_cell.did"
    },
    "query_aggregator": {
      "type": "rust",
      "package": "query_aggregator",
      "candid": "canisters/query_aggregator/query_aggregator.did"
    },
    "atlas_mesh": {
      "type": "rust",
      "package": "atlas_mesh",
      "candid": "canisters/atlas_mesh/atlas_mesh.did"
    }
  },
  "defaults": {
    "build": {
      // Performance optimization: Enable release mode for production builds
      "args": "--release",
      "packtool": ""
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral",
      // Cycle optimization: Increase subnet memory for better performance
      "subnet": {
        "memory_capacity": "8589934592"
      }
    },
    "ic": {
      "providers": ["https://ic0.app"],
      "type": "persistent"
    }
  }
}
